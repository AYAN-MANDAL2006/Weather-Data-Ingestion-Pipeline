# Weather Data Ingestion Pipeline - Environment Configuration
# Copy this file to .env and modify if needed

# Target Location Settings (Defaults to Faridabad, Haryana, India)
WEATHER_LOCATION_NAME=Faridabad, Haryana, India
WEATHER_LATITUDE=28.4089
WEATHER_LONGITUDE=77.3178
WEATHER_TIMEZONE=Asia/Kolkata

# API Configuration
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
API_TIMEOUT_SECONDS=15
API_MAX_RETRIES=3
API_RETRY_BACKOFF_FACTOR=1.5

# Storage Configuration
DUCKDB_DATABASE_PATH=data/weather_data.duckdb
DLT_PIPELINE_NAME=weather_ingestion_pipeline
DLT_DATASET_NAME=weather_analytics

# Dagster Configuration
DAGSTER_HOME=dagster_home
